# Names only. No values, ever. See CLAUDE.md § 5 — secrets live in macOS
# Keychain (`security find-generic-password`), never in a committed .env.
#
# The NIM key itself is NOT an env var — it is stored in Keychain under the
# service name "jarvis-nim-key" (see README.md Phase 0 quickstart):
#   security add-generic-password -a "$USER" -s jarvis-nim-key -w 'nvapi-...'

# Overrides the default NIM model used by bench/nim_smoke.sh and the `nim`
# provider. Optional — falls back to meta/llama-3.3-70b-instruct.
NIM_MODEL=
